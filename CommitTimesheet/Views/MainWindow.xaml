<Window x:Class="CommitTimesheet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CommitTimesheet.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Commit Timesheet"
        Width="1180" Height="820" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.3*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="From" Style="{StaticResource Muted}" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120" VerticalContentAlignment="Center" />
                    <TextBlock Text="To" Style="{StaticResource Muted}" Margin="12,0,6,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120" VerticalContentAlignment="Center" />
                    <Button Content="This month" Command="{Binding ThisMonthCommand}" Margin="12,0,0,0" />
                    <Button Content="Last month" Command="{Binding LastMonthCommand}" Margin="6,0,0,0" />
                    <Button Command="{Binding RefreshCommand}" Margin="18,0,0,0" ToolTip="Reload commits">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" ToolTip="Turn the commits into timesheet rows with Claude">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" />
                            <TextBlock Text="Generate" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Right" Command="{Binding OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="14,12,14,6">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Commits" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding CommitCountText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
            </DockPanel>
            <Grid>
                <DataGrid ItemsSource="{Binding Commits}"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          ClipboardCopyMode="ExcludeHeader">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Width="95" Binding="{Binding AuthorDate, StringFormat=M/d/yyyy}" />
                        <DataGridTextColumn Header="DOW" Width="55" Binding="{Binding AuthorDate, StringFormat=ddd}" />
                        <DataGridTextColumn Header="Repo" Width="115" Binding="{Binding Repo}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Branch" Width="260" Binding="{Binding Branch}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Subject}" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding CommitsEmptyText}"
                           Style="{StaticResource HiddenWhenEmpty}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14" />
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ShowsPreview="False" />

        <DockPanel Grid.Row="3" Margin="14,6,14,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Timesheet" Style="{StaticResource SectionHeader}" />
                <Button DockPanel.Dock="Left" Command="{Binding InsertRowCommand}" Margin="16,0,0,0" ToolTip="Insert a row below the selected one">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" />
                        <TextBlock Text="Insert row" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Command="{Binding DeleteRowCommand}" Margin="6,0,0,0" ToolTip="Delete the selected row">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                        <TextBlock Text="Delete row" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding CopyForSheetCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Copy every row as tab-separated text">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" />
                        <TextBlock Text="Copy for sheet" />
                    </StackPanel>
                </Button>
            </DockPanel>
            <Grid>
                <DataGrid x:Name="TimesheetGrid"
                          ItemsSource="{Binding TimesheetRows}"
                          SelectedItem="{Binding SelectedTimesheetRow}"
                          SelectionMode="Single"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          PreviewKeyDown="OnTimesheetGridPreviewKeyDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WeekendTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Width="95" Binding="{Binding DateText, Mode=OneWay}" IsReadOnly="True" />
                        <DataGridTextColumn Header="DOW" Width="55" Binding="{Binding Dow, Mode=OneWay}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Who" Width="90" Binding="{Binding Who, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Projects" Width="110" Binding="{Binding Project, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Hrs" Width="55" Binding="{Binding HoursText, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasValidHours}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ticket Title" Width="*" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="" Width="120" Binding="{Binding DayCheck, Mode=OneWay}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Click Generate to build timesheet rows from the commits above."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TimesheetRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="90" Height="6" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Generating with Claude…" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Command="{Binding CancelGenerateCommand}" Padding="10,0" MinHeight="24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
