<Window x:Class="CommitTimesheet.Views.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="420" MinWidth="420" MinHeight="260"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CopyButton" Click="OnCopyClick" MinWidth="84">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" />
                    <TextBlock x:Name="CopyLabel" Text="Copy" />
                </StackPanel>
            </Button>
            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="84" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBox x:Name="DetailsText"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12"
                 Padding="6"
                 VerticalScrollBarVisibility="Auto"
                 BorderBrush="{StaticResource BorderBrush}" />
    </DockPanel>
</Window>
